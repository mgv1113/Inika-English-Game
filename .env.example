# Dominio público del juego. Con "localhost" Caddy usa un certificado local.
DOMAIN=english-game.inikatech.com

POSTGRES_USER=inika
POSTGRES_PASSWORD=cambia-esta-contraseña
POSTGRES_DB=inika

# Solo si el VPS ya tiene nginx-proxy + acme-companion en los puertos 80/443:
# descomenta estas dos líneas y pon la red de nginx-proxy (ver docs/despliegue.md).
# COMPOSE_FILE=docker-compose.yml:docker-compose.nginx-proxy.yml
# PROXY_NETWORK=nombre-de-la-red-de-nginx-proxy
